{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "corpus_enunciacoes",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "persona",
      "transcricao_bruta",
      "texto_normalizado",
      "intencao",
      "entidades",
      "exige_confirmacao",
      "anotadores",
      "concordancia"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^enu_\\d{4}$"
      },
      "persona": {
        "enum": [
          "inspecao_trafego",
          "guincho",
          "aph",
          "supervisor",
          "gerente"
        ]
      },
      "transcricao_bruta": {
        "type": "string",
        "minLength": 1
      },
      "texto_normalizado": {
        "type": "string",
        "minLength": 1
      },
      "intencao": {
        "enum": [
          "registrar_ocorrencia",
          "relatar_condicoes",
          "registrar_dados_atendimento",
          "consultar_procedimento",
          "consultar_dados_ocorrencia",
          "consultar_recursos",
          "atualizar_status",
          "solicitar_apoio",
          "encerrar_atendimento",
          "gerar_resumo",
          "consultar_panorama",
          "consultar_prioridades",
          "consultar_historico",
          "consultar_indicadores",
          "consultar_pendencias",
          "validar_registro",
          "registrar_direcionamento",
          "confirmar",
          "negar_corrigir",
          "cancelar",
          "fora_de_escopo"
        ]
      },
      "entidades": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tipo",
            "valor",
            "span"
          ],
          "properties": {
            "tipo": {
              "enum": [
                "tag_ocorrencia",
                "km",
                "sentido",
                "faixa",
                "tipo_ocorrencia",
                "recurso",
                "status",
                "horario",
                "condicao_observada",
                "trecho",
                "periodo"
              ]
            },
            "valor": {
              "type": [
                "number",
                "string"
              ]
            },
            "span": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      },
      "exige_confirmacao": {
        "type": "boolean"
      },
      "anotadores": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 2
      },
      "concordancia": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    }
  }
}